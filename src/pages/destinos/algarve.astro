---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { regionHubs } from '../../data/regionHubs';

const hub = regionHubs.algarve;
const westernGuides = [
  { name: 'Lagos', href: '/destinos/lagos/', text: 'Ponta da Piedade, Rota Vicentina, playas y alternativa forestal.' },
  { name: 'Sagres', href: '/destinos/sagres/', text: 'Cabo de São Vicente, acantilados, senderismo y reglas de playa.' },
  { name: 'Aljezur', href: '/destinos/aljezur/', text: 'Arrifana, Odeceixe, Monte Clérigo y etapas de Rota Vicentina.' }
];
const centralGuides = [
  { name: 'Portimão', href: '/destinos/portimao/', text: 'Praia da Rocha, Alvor y recorridos naturales alrededor de la ría.' },
  { name: 'Carvoeiro', href: '/destinos/carvoeiro/', text: 'Sete Vales Suspensos, Marinha, Benagil y accesibilidad de calas.' }
];
const easternGuides = [
  { name: 'Tavira', href: '/destinos/tavira/', text: 'Ria Formosa, Barril a pie, playas con barco y temporada balnear 2026.' }
];
---
<BaseLayout
  title="Algarve con perro · Qué zona elegir y dónde alojarse"
  description="Guía para elegir zona del Algarve viajando con perro: oeste, centro y este, rutas, reglas de playa y acceso a guías locales verificadas."
>
  <section class="destination-hero">
    <div class="container">
      <span class="eyebrow">Sur de Portugal · Hub regional</span>
      <h1 style="font-size:clamp(3rem,7vw,6rem)">Algarve con perro</h1>
      <p style="max-width:820px;color:var(--muted);font-size:1.12rem;margin-top:20px">No buscamos decirte simplemente que “el Algarve es dog-friendly”. Queremos ayudarte a elegir <strong>qué parte del Algarve encaja mejor con tu viaje y tu perro</strong>, y después llevarte a alojamientos que encajen con tus condiciones.</p>
      <div class="score">
        <span>✅ Hub regional investigado con fuentes oficiales</span>
        <strong style="font-size:.95rem">Revisado {hub.reviewedAt}</strong>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container content-grid">
      <div>
        <span class="eyebrow">Antes de reservar</span>
        <h2>Primero elige zona. Luego casa.</h2>
        <p style="color:var(--muted);margin-top:18px;font-size:1.05rem">{hub.intro}</p>

        <div style="margin-top:44px">
          <span class="eyebrow">Mapa mental del Algarve</span>
          <h2 style="font-size:clamp(1.8rem,3.2vw,2.7rem);margin-top:6px">Tres zonas para empezar a decidir</h2>
          <div class="card-grid" style="margin-top:24px;grid-template-columns:1fr">
            {hub.areas.map((area, index) => (
              <article class="card">
                <div class="card-body" style="padding:26px">
                  <div class="meta" style="margin-top:0">
                    <span class="pill">Zona {index + 1}</span>
                    <span class="pill">{area.kicker}</span>
                  </div>
                  <h3 style="font-size:1.5rem">{area.name}</h3>
                  <p style="margin-top:10px">{area.summary}</p>
                  <div class="meta">
                    {area.places.map((place) => <span class="pill">📍 {place}</span>)}
                  </div>
                  <p style="margin-top:12px"><strong>Mirada con perro:</strong> {area.dogLens}</p>
                  {area.name === 'Algarve occidental' && (
                    <div class="meta" style="margin-top:20px">
                      {westernGuides.map((guide) => (
                        <a class="nav-cta" href={guide.href}>Guía de {guide.name} →</a>
                      ))}
                    </div>
                  )}
                  {area.name === 'Algarve central' && (
                    <div class="meta" style="margin-top:20px">
                      {centralGuides.map((guide) => (
                        <a class="nav-cta" href={guide.href}>Guía de {guide.name} →</a>
                      ))}
                    </div>
                  )}
                  {area.name === 'Algarve oriental' && (
                    <div class="meta" style="margin-top:20px">
                      {easternGuides.map((guide) => (
                        <a class="nav-cta" href={guide.href}>Guía de {guide.name} →</a>
                      ))}
                    </div>
                  )}
                </div>
              </article>
            ))}
          </div>
        </div>

        <div style="margin-top:50px">
          <span class="eyebrow">Según tu tipo de viaje</span>
          <h2 style="font-size:clamp(1.8rem,3.2vw,2.7rem);margin-top:6px">Qué miraría antes de elegir base</h2>
          <div class="card-grid" style="margin-top:24px;grid-template-columns:repeat(2,minmax(0,1fr))">
            {hub.decisions.map((decision) => (
              <article class="card">
                <div class="card-body">
                  <h3>{decision.title}</h3>
                  <p>{decision.summary}</p>
                </div>
              </article>
            ))}
          </div>
        </div>

        <div style="margin-top:50px">
          <span class="eyebrow">Rutas y costa</span>
          <h2 style="font-size:clamp(1.8rem,3.2vw,2.7rem);margin-top:6px">Tres reglas que evitan sorpresas</h2>
          <div class="card-grid" style="margin-top:24px;grid-template-columns:repeat(2,minmax(0,1fr))">
            {hub.routeNotes.map((note) => (
              <article class="card">
                <div class="card-body">
                  <h3>{note.title}</h3>
                  <p>{note.summary}</p>
                  <a class="card-link" style="display:inline-block;margin-top:14px" href={note.sourceUrl} target="_blank" rel="noopener">Fuente: {note.sourceLabel} ↗</a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>

      <aside>
        <div class="side-card">
          <span class="eyebrow">Alojamientos</span>
          <h3 style="margin-top:8px">Primero afiliación; los filtros potentes vendrán después</h3>
          <p style="color:var(--muted);margin-top:12px">Mientras no tengamos un feed/API con atributos caninos suficientemente buenos, no fingiremos un buscador propio. Empezaremos llevando al usuario a inventario real del Algarve mediante afiliación y solo activaremos filtros como vallado o número de perros cuando podamos respaldarlos.</p>
          <a class="nav-cta" style="display:inline-block;margin-top:18px" href="/alojamientos/?destino=algarve">Cómo buscaremos alojamiento →</a>
        </div>

        <div class="side-card" style="margin-top:20px;background:white;border:1px solid var(--line)">
          <span class="eyebrow">Guías verificadas del oeste</span>
          <h3 style="margin-top:8px">Tres bases para comparar</h3>
          <div style="display:grid;gap:14px;margin-top:14px">
            {westernGuides.map((guide) => (
              <div>
                <a class="card-link" href={guide.href}>{guide.name} con perro →</a>
                <p style="color:var(--muted);font-size:.9rem;margin-top:3px">{guide.text}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="side-card" style="margin-top:20px;background:white;border:1px solid var(--line)">
          <span class="eyebrow">Guías verificadas del centro</span>
          <h3 style="margin-top:8px">Dos bases muy diferentes</h3>
          <div style="display:grid;gap:14px;margin-top:14px">
            {centralGuides.map((guide) => (
              <div>
                <a class="card-link" href={guide.href}>{guide.name} con perro →</a>
                <p style="color:var(--muted);font-size:.9rem;margin-top:3px">{guide.text}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="side-card" style="margin-top:20px;background:white;border:1px solid var(--line)">
          <span class="eyebrow">Guías verificadas del este</span>
          <h3 style="margin-top:8px">Primera base en Ria Formosa</h3>
          <div style="display:grid;gap:14px;margin-top:14px">
            {easternGuides.map((guide) => (
              <div>
                <a class="card-link" href={guide.href}>{guide.name} con perro →</a>
                <p style="color:var(--muted);font-size:.9rem;margin-top:3px">{guide.text}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="side-card" style="margin-top:20px;background:white;border:1px solid var(--line)">
          <span class="eyebrow">Fuentes</span>
          <h3 style="margin-top:8px">Consultadas</h3>
          <ul>
            {hub.sources.map((source) => (
              <li style="margin-bottom:8px"><a class="card-link" href={source.url} target="_blank" rel="noopener">{source.label} ↗</a></li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container trust">
      <div class="trust-item"><span>1</span><h3>Elige zona</h3><p>No tratamos 200 km de costa como si fueran el mismo destino.</p></div>
      <div class="trust-item"><span>2</span><h3>Comprueba reglas</h3><p>Playas, rutas y espacios protegidos se verifican con fuentes y fecha.</p></div>
      <div class="trust-item"><span>3</span><h3>Reserva</h3><p>Empezaremos con inventario afiliado real y evolucionaremos a filtros propios cuando tengamos datos suficientemente buenos.</p></div>
    </div>
  </section>
</BaseLayout>
