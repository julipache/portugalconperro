---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

const { items } = Astro.props as { items: BreadcrumbItem[] };
const base = Astro.site ?? new URL('https://portugalconperro.com');
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: item.href ? new URL(item.href, base).href : new URL(Astro.url.pathname, base).href
  }))
};
---
<nav aria-label="Migas de pan" class="container" style="padding-top:18px;padding-bottom:18px">
  <ol style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;list-style:none;padding:0;margin:0;color:var(--muted);font-size:.9rem">
    {items.map((item, index) => (
      <li style="display:flex;gap:8px;align-items:center">
        {index > 0 && <span aria-hidden="true">›</span>}
        {item.href ? <a class="card-link" href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
