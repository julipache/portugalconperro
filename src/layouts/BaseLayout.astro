---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Portugal con Perro · Alojamientos y destinos dog friendly',
  description = 'Guía para viajar por Portugal con perro: alojamientos, jardines vallados, playas, rutas y lugares realmente dog friendly.'
} = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#176b50" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container nav">
        <a class="brand" href="/" aria-label="Portugal con Perro, inicio">
          <span class="brand-mark">🐾</span>
          <span>Portugal con Perro</span>
        </a>
        <nav class="nav-links" aria-label="Principal">
          <a href="/alojamientos/">Alojamientos</a>
          <a href="/#destinos">Destinos</a>
          <a href="/#como-funciona">Cómo verificamos</a>
          <a class="nav-cta" href="/alojamientos/">Buscar casa</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <div class="brand"><span class="brand-mark">🐾</span><span>Portugal con Perro</span></div>
          <p>Una guía especializada para encontrar lugares donde viajar con tu perro sin descubrir las condiciones importantes después de reservar.</p>
        </div>
        <p>Proyecto en construcción · La información de alojamientos se mostrará con fuente, fecha de revisión y nivel de verificación.</p>
      </div>
    </footer>
  </body>
</html>
